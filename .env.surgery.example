# Surgery Platform Configuration
# Copy this file to .env and edit with your settings

# ── CVAT base settings ──
CVAT_HOST=localhost
CVAT_VERSION=dev

# ── LLM Configuration ──
# Option A: Local llama-cpp (start with: docker compose --profile local-llm up)
#   Download a GGUF model to ./models/ and set:
#   LLM_API_URL=http://llm:8000/v1/chat/completions
#   LLM_MODEL=default
#   LLM_MODEL_FILE=Meta-Llama-3.1-8B-Instruct-Q5_K_M.gguf
#
# Option B: Remote API (OpenAI-compatible endpoint)
#   LLM_API_URL=https://api.openai.com/v1/chat/completions
#   LLM_MODEL=gpt-4o
#   (Set OPENAI_API_KEY in your environment)
#
# Option C: NVIDIA Inference API for Copilot (GPT-5.4)
#   COPILOT_LLM_URL=https://inference-api.nvidia.com/v1/chat/completions
#   COPILOT_LLM_MODEL=azure/openai/gpt-5.4
#   NVIDIA_API_KEY=nvapi-...

LLM_API_URL=http://llm:8000/v1/chat/completions
LLM_MODEL=default
LLM_MODEL_FILE=model.gguf

# ── Parakeet ASR ──
# Backend ASR endpoint for narration transcription
TRANSCRIPTION_ASR_URL=http://parakeet:8888/asr
PARAKEET_IMAGE=nvcr.io/nvidia/nemo:24.12
PARAKEET_PORT=8888

# ── AWS S3 (configured via CVAT Cloud Storage UI) ──
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
